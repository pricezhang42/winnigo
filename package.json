{
  "name": "winnigo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/node-app.mjs dev",
    "build": "node scripts/node-app.mjs build",
    "start": "node scripts/node-app.mjs start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "collect:hiking": "python3 scripts/collect-hiking-selenium.py --headless",
    "publish:hiking": "node scripts/publish-social.mjs",
    "db:seed": "node scripts/seed-node.mjs",
    "worker": "node scripts/worker.mjs",
    "worker:check": "node scripts/worker.mjs --once",
    "services:up": "docker compose --env-file .env.local up -d --wait postgres storage",
    "services:down": "docker compose --env-file .env.local stop postgres storage",
    "services:check": "node scripts/check-services.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:p2": "node scripts/check-p2.mjs",
    "migrate:export": "python3 scripts/export-legacy.py",
    "migrate:media": "node scripts/fetch-legacy-media.mjs",
    "migrate:import": "node scripts/import-legacy.mjs",
    "media:cleanup": "node scripts/cleanup-media.mjs",
    "check:p3": "node scripts/check-p3.mjs",
    "check:p5": "node scripts/check-p5.mjs",
    "accounts:manage": "node scripts/manage-accounts.mjs",
    "accounts:cleanup": "node scripts/cleanup-accounts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pg-boss": "12.33.4",
    "pngjs": "7.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
