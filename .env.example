# npm run setup creates .env.local with random credentials. Do not commit it.
WINNIGO_AUTH_MODE=session
WINNIGO_ADMIN_USER=owner
WINNIGO_ADMIN_PASSWORD=replace-with-random-password
WINNIGO_COLLECTOR_KEY=replace-with-separate-random-secret
WINNIGO_HOST=127.0.0.1
PORT=5173
WINNIGO_ORIGIN=http://127.0.0.1:5173
WINNIGO_REPOSITORY=postgres
WINNIGO_STORAGE=s3
WINNIGO_DATA_DIR=.winnigo/node
WINNIGO_SEED_PROFILE=snapshot
POSTGRES_PASSWORD=winnigo
DATABASE_URL=postgres://winnigo:winnigo@127.0.0.1:55433/winnigo
S3_ENDPOINT=http://127.0.0.1:58334
S3_REGION=us-east-1
S3_BUCKET=winnigo-dev
S3_ACCESS_KEY=replace-with-random-key
S3_SECRET_KEY=replace-with-random-secret

# Individual accounts (session mode); registration remains invitation-only.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WINNIGO_MAIL_MODE=file
WINNIGO_MAIL_DIR=.winnigo/mail
# Use smtp outside loopback; keep credentials in the private environment.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WINNIGO_CONTAINER_AUTH_MODE=session

# Collection jobs (P5). The worker always runs manually queued refreshes; daily source schedules
# start only with WINNIGO_SCHEDULES=enabled. WINNIGO_JOBS_SCHEMA names the pg-boss schema.
WINNIGO_SCHEDULES=disabled
WINNIGO_JOBS_SCHEMA=winnigo_jobs

# Optional WAG collector. Origin only; keep FlareSolverr private. WAG is manual-only.
# Host worker: http://127.0.0.1:8191; Docker worker: http://host.docker.internal:8191
WINNIGO_FLARESOLVERR_URL=

# Optional host-worker photo downloads via the existing FlareSolverr container (Docker CLI).
WINNIGO_WAG_PHOTO_CONTAINER=

# Optional event extraction service. Only sources listed in WINNIGO_EXTRACTION_SOURCES use it.
WINNIGO_EXTRACTION_PROVIDER=disabled
OPENAI_API_KEY=
WINNIGO_EXTRACTION_MODEL=
WINNIGO_EXTRACTION_MAX_INPUT_TOKENS=12000
WINNIGO_EXTRACTION_MAX_OUTPUT_TOKENS=4096
WINNIGO_EXTRACTION_TIMEOUT_MS=30000
WINNIGO_EXTRACTION_RUN_BUDGET_USD=
WINNIGO_EXTRACTION_INPUT_USD_PER_MILLION=
WINNIGO_EXTRACTION_OUTPUT_USD_PER_MILLION=
# Per-source rollout, e.g. manitoba-museum=shadow (compare only; listings stay parser-owned).
WINNIGO_EXTRACTION_SOURCES=
WINNIGO_EXTRACTION_SHADOW_MAX_MS=180000
