# Production settings for compose.production.yaml (docs/32-deployment.md). Copy to
# .env.production on the server (chmod 600) and fill in every value there. Never commit it,
# and keep secrets out of chat, tickets and logs. compose.production.yaml sets DATABASE_URL,
# WINNIGO_AUTH_MODE=session, WINNIGO_HOST, WINNIGO_DATA_DIR and WINNIGO_CLIENT_IP_HEADER.

# The public address. Caddy gets the HTTPS certificate for WINNIGO_DOMAIN.
WINNIGO_DOMAIN=winnigo.lpzdev.com
WINNIGO_ORIGIN=https://winnigo.lpzdev.com
PORT=5173

# Database password (openssl rand -hex 24). Used by the postgres service and DATABASE_URL.
POSTGRES_PASSWORD=

# Sessions: a new random value for production only (openssl rand -base64 48). Rotating it signs
# everyone out; do it if the database is ever exposed. Never reuse the local one.
BETTER_AUTH_SECRET=

# Launch stages (docs/31): start with disabled/invitation, open them when you decide to.
WINNIGO_PUBLIC_BROWSING=disabled
# Search engines may index the site (needs public browsing; robots.txt and X-Robots-Tag follow).
WINNIGO_INDEXING=disabled
WINNIGO_SIGNUP=invitation
# Shown on the privacy policy and terms pages.
WINNIGO_CONTACT_EMAIL=

# Email (Resend SMTP). The API key is the SMTP password.
WINNIGO_MAIL_MODE=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Winnigo <no-reply@winnigo.lpzdev.com>"

# Google sign-in. Redirect URI: https://winnigo.lpzdev.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photos: a private Cloudflare R2 bucket (S3 API). Region is always "auto" on R2.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=winnigo-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Database backups: a separate private R2 bucket. A token limited to this bucket is better
# than reusing the media token (leave these empty to reuse it).
BACKUP_S3_BUCKET=winnigo-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30

# Collection. Daily schedules run only on this one host (docs/17, docs/18).
WINNIGO_SCHEDULES=enabled
WINNIGO_EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
WINNIGO_EXTRACTION_MODEL=gpt-6-luna
WINNIGO_EXTRACTION_INPUT_USD_PER_MILLION=0.10
WINNIGO_EXTRACTION_OUTPUT_USD_PER_MILLION=0.50
WINNIGO_EXTRACTION_RUN_BUDGET_USD=0.40
WINNIGO_EXTRACTION_TIMEOUT_MS=120000

# Operator access to collector imports (P6); a long random value.
WINNIGO_COLLECTOR_KEY=
